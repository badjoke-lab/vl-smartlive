{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@vl-smartlive/log-schema": [
        "packages/log-schema/src/index.ts"
      ],
      "@vl-smartlive/comment-radar": [
        "packages/comment-radar/src/index.ts"
      ],
      "@vl-smartlive/report-engine": [
        "packages/report-engine/src/index.ts"
      ],
      "@vl-smartlive/shared-config": [
        "packages/shared-config/src/index.ts"
      ]
    }
  }
}
